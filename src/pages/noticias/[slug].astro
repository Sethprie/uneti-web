---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getNoticias, readingTime, type Noticia } from '../../utils/content';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props as { noticia: Noticia };
const { Content, headings } = await render(noticia);
const { data } = noticia;
---

<ArticleLayout
  title={data.title}
  description={data.description}
  crumbs={[{ label: 'Noticias', href: '/noticias' }, { label: data.title }]}
  kicker="Noticia"
  author={data.author}
  date={data.date}
  updated={data.updated}
  minutes={readingTime(noticia.body)}
  tags={data.tags}
  headings={headings}
  back={{ href: '/noticias', label: 'Volver a las noticias' }}
>
  <Content />
</ArticleLayout>

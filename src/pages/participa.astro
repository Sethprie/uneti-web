---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Community from '../components/home/Community.astro';
import { site } from '../config/site';

const pasos = [
  {
    title: 'Elige un tema',
    text: 'Algo que te costó resolver y que a otros les pueda servir: un trámite, una materia, un consejo.',
  },
  {
    title: 'Escríbelo como se lo contarías a un amigo',
    text: 'Frases cortas, pasos numerados y, si dependes de una fecha o regla oficial, el enlace a la fuente.',
  },
  {
    title: 'Envíalo al equipo',
    text: 'Lo revisamos, te proponemos ajustes si hace falta y lo publicamos con tu nombre.',
  },
];
---

<BaseLayout title="Participa" description="Cómo escribir una guía o una noticia para la web.">
  <PageHeader
    title="Participa"
    eyebrow="Esta web la hacemos entre todos"
    lead="No hace falta saber programar. Si sabes algo útil, puedes compartirlo."
    crumbs={[{ label: 'Participa' }]}
  />

  <div class="container section">
    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="community-block">
      <h2>Habla con el equipo</h2>
      <p class="muted">La forma más rápida de proponer algo es escribirnos en la comunidad.</p>
      <Community heading={false} />
    </div>

    <div class="prose">
      <h2>Para quien sí programa</h2>
      <p>
        Cada guía y noticia es un archivo Markdown dentro de <code>src/content/</code>. Para publicar una, crea
        un archivo nuevo copiando uno de los existentes, rellena los datos de arriba (título, descripción, fecha
        o categoría) y escribe el texto debajo.
      </p>
      <ul>
        <li><code>src/content/guias/</code> para guías paso a paso.</li>
        <li><code>src/content/noticias/</code> para noticias con fecha.</li>
      </ul>
      {site.repoUrl && (
        <p>
          El código está en <a href={site.repoUrl}>el repositorio del proyecto</a>. Abre un pull request con tu
          archivo y lo revisamos.
        </p>
      )}
      {site.contact && (
        <p>
          ¿Prefieres enviarlo sin tocar código? <a href={site.contact}>Escríbenos</a>.
        </p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .community-block {
    margin-bottom: 56px;
  }

  .community-block h2 {
    margin-bottom: 6px;
  }

  .pasos {
    list-style: none;
    padding: 0;
    margin: 0 0 56px;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .pasos li {
    display: flex;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--brand-orange);
    color: var(--brand-navy);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
  }

  .pasos h2 {
    font-size: 1.4rem;
    margin-bottom: 6px;
  }

  .pasos p {
    margin: 0;
    color: var(--text-muted);
  }
</style>

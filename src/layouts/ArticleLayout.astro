---
/** Plantilla para leer una noticia o una guía. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import TagList from '../components/ui/TagList.astro';
import TableOfContents from '../components/ui/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import { formatDate } from '../utils/content';

interface Props {
  title: string;
  description: string;
  crumbs: { label: string; href?: string }[];
  kicker?: string;
  author: string;
  date?: Date;
  updated?: Date;
  minutes: number;
  tags: string[];
  back: { href: string; label: string };
  /** Títulos del texto. Con cuatro o más secciones se muestra un índice. */
  headings?: MarkdownHeading[];
}

const { title, description, crumbs, kicker, author, date, updated, minutes, tags, back, headings = [] } = Astro.props;
const showToc = headings.filter((h) => h.depth === 2).length >= 4;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={{ published: date, modified: updated, author, section: kicker, tags }}
  breadcrumbs={crumbs}
>
  <article class="article">
    <header class="article-header">
      <div class="container narrow">
        <Breadcrumbs items={crumbs} />
        {kicker && <span class="eyebrow">{kicker}</span>}
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="meta">
          <span>Por {author}</span>
          {date && <span>Publicado el <time datetime={date.toISOString()}>{formatDate(date)}</time></span>}
          {
            updated && (
              <span>
                Actualizado el <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            )
          }
          <span>{minutes} min de lectura</span>
        </p>
      </div>
    </header>

    <div class="container narrow body">
      {showToc && <TableOfContents headings={headings} />}
      <div class="prose">
        <slot />
      </div>

      <footer class="article-footer">
        <TagList tags={tags} />
        <a class="link-arrow" href={back.href}>← {back.label}</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<script>
  // Los enlaces del texto se abren en una pestaña nueva para no perder el sitio
  // de lectura. Los que llevan a una sección de la misma página (#...), no.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.prose a[href]')) {
    if (a.getAttribute('href')!.startsWith('#')) continue;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    const hint = document.createElement('span');
    hint.className = 'sr-only';
    hint.textContent = ' (se abre en una pestaña nueva)';
    a.append(hint);
  }
</script>

<style>
  .narrow {
    max-width: 820px;
  }

  .article-header {
    padding-block: clamp(32px, 6vw, 56px) 32px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
  }

  .lead {
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .meta span + span::before {
    content: '·';
    margin-right: 18px;
    margin-left: -12px;
    opacity: 0.6;
  }

  .body {
    padding-block: 40px 64px;
  }

  .article-footer {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
</style>

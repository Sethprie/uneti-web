---
import Logo from '../brand/Logo.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="copy">
      <p class="badge">
        <span class="dot" aria-hidden="true"></span>
        Por y para estudiantes
      </p>
      <h1>
        La UNETI explicada <span class="hl">por quienes la viven</span>
      </h1>
      <p class="lead">
        Guías, noticias y recursos escritos por estudiantes para estudiantes. Lo que nos habría gustado
        saber el primer día, en un solo lugar y sin vueltas.
      </p>
      <div class="ctas">
        <a class="btn" href="/guias">Empieza por las guías</a>
        <a class="btn btn--ghost" href="/noticias">Ver noticias</a>
      </div>
      <p class="note">
        ¿Sabes algo que le sirva a otros? <a href="/participa">Escribe con nosotros →</a>
      </p>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="logo-wrap">
        <Logo variant="full" title="" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60% 60% at 85% 20%, color-mix(in srgb, var(--brand-teal) 14%, transparent), transparent 70%),
      radial-gradient(40% 50% at 70% 90%, color-mix(in srgb, var(--brand-orange) 10%, transparent), transparent 70%),
      var(--bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 650;
    margin-bottom: 20px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--brand-orange);
    box-shadow: 14px 0 0 var(--brand-teal);
    margin-right: 14px;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    margin-bottom: 20px;
  }

  .hl {
    color: var(--accent);
  }

  .lead {
    margin-bottom: 28px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .note {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .note a {
    font-weight: 650;
  }

  .visual {
    display: grid;
    place-items: center;
  }

  .logo-wrap {
    width: min(100%, 340px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .visual {
      order: -1;
      justify-items: start;
    }
    .logo-wrap {
      width: 150px;
      padding: 18px;
      border-radius: 20px;
    }
  }
</style>

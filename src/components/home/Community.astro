---
/** Tarjetas destacadas de Discord y WhatsApp. Sin URL, muestran "Próximamente". */
import { community } from '../../config/site';

interface Props {
  /** Muestra el encabezado de la sección. */
  heading?: boolean;
}

const { heading = true } = Astro.props;
---

<section class="community" aria-labelledby={heading ? 'comunidad' : undefined} aria-label={heading ? undefined : 'Comunidad'}>
  {
    heading && (
      <div class="head">
        <span class="eyebrow">Comunidad</span>
        <h2 id="comunidad">Únete a la comunidad estudiantil</h2>
        <p class="muted">Resuelve dudas, comparte apuntes y entérate de todo con tus compañeros.</p>
      </div>
    )
  }

  <div class="cards">
    {
      community.map((c) => (
        <article class="card" style={`--c: ${c.color}`}>
          <span class="icon" aria-hidden="true">
            {c.id === 'discord' ? (
              <svg viewBox="0 0 24 24">
                <path d="M7 7.5c3.3-1.4 6.7-1.4 10 0 1.6 2.4 2.4 5 2.3 8.1-1.4 1.1-2.8 1.8-4.3 2.2l-1-1.7M7 7.5C5.4 9.9 4.6 12.5 4.7 15.6 6.1 16.7 7.5 17.4 9 17.8l1-1.7M8.2 15.3c2.5 1.1 5.1 1.1 7.6 0" />
                <circle cx="9.6" cy="12" r="1.2" />
                <circle cx="14.4" cy="12" r="1.2" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24">
                <path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6Z" />
                <path d="M9.3 8.6c.2 2.9 2.6 5.5 5.9 6.1l1.1-1.3-1.8-1-1 .7c-1-.4-2-1.4-2.4-2.4l.7-1-1-1.8Z" />
              </svg>
            )}
          </span>
          <div class="body">
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </div>
          {c.url ? (
            <a class="btn join" href={c.url} target="_blank" rel="noopener">
              {c.cta}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          ) : (
            <span class="soon">Próximamente</span>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .head {
    margin-bottom: 24px;
  }

  .head h2 {
    margin-bottom: 8px;
  }

  .head p {
    margin: 0;
  }

  .cards {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 16px 20px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border));
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 12%, var(--surface)), var(--surface) 70%);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--c);
    color: #fff;
  }

  .icon svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon circle {
    fill: currentColor;
    stroke: none;
  }

  h3 {
    font-size: 1.6rem;
    margin-bottom: 4px;
  }

  .body p {
    margin: 0;
    color: var(--text-muted);
  }

  .join,
  .soon {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .join {
    background: var(--c);
    border-color: var(--c);
    color: #fff;
  }

  .soon {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 10px 22px;
    border-radius: 999px;
    border: 2px dashed color-mix(in srgb, var(--c) 60%, var(--border));
    color: var(--text-muted);
    font-weight: 650;
  }
</style>

---
/** Comunidad independiente (no oficial) de UNETI Estudiantil: WhatsApp y Discord. */
import Icon from '../ui/Icon.astro';
import { community, communityAbout } from '../../config/site';

interface Props {
  /** Muestra el título y la presentación de la sección. */
  heading?: boolean;
}

const { heading = true } = Astro.props;
---

<section
  class="community"
  aria-labelledby={heading ? 'comunidad' : undefined}
  aria-label={heading ? undefined : 'Nuestra comunidad'}
>
  {
    heading && (
      <div class="head">
        <span class="eyebrow">Comunidad independiente</span>
        <h2 id="comunidad">Sobre nuestra comunidad</h2>
        <p class="about">{communityAbout}</p>
      </div>
    )
  }

  <div class="cards">
    {
      community.map((c) => (
        <article class="card" style={`--c: ${c.color}`}>
          <span class="icon" aria-hidden="true">
            <Icon name={c.icon} size={30} />
          </span>
          <div class="body">
            <span class="unofficial">No oficial</span>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </div>
          {c.url ? (
            <a class="btn join" href={c.url} target="_blank" rel="noopener">
              {c.cta}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          ) : (
            <span class="soon">Próximamente</span>
          )}
        </article>
      ))
    }
  </div>

  <p class="notice">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 11v5M12 8h.01"></path>
    </svg>
    <span>
      Estos grupos no son oficiales. La comunidad oficial de estudiantes es la de la representación estudiantil
      MEU Código 200: la encontrarás en <a href="/#canales-oficiales">Canales oficiales</a>.
    </span>
  </p>
</section>

<style>
  .head {
    margin-bottom: 24px;
  }

  .head h2 {
    margin-bottom: 8px;
  }

  .about {
    margin: 0;
    max-width: 70ch;
    color: var(--text-muted);
  }

  .cards {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 16px 20px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border));
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 12%, var(--surface)), var(--surface) 70%);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--c);
    color: #fff;
  }

  .unofficial {
    display: inline-block;
    margin-bottom: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.6rem;
    margin-bottom: 4px;
  }

  .body p {
    margin: 0;
    color: var(--text-muted);
  }

  .join,
  .soon {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .join {
    background: var(--c);
    border-color: var(--c);
    color: #fff;
  }

  .soon {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 10px 22px;
    border-radius: 999px;
    border: 2px dashed color-mix(in srgb, var(--c) 60%, var(--border));
    color: var(--text-muted);
    font-weight: 650;
  }

  .notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 16px 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .notice svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>

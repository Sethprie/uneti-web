---
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
import { community, nav, navCta, officialChannels, site } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid-footer">
    <div class="about">
      <Logo variant="full" class="footer-logo" />
      <p>
        <strong>{site.name}</strong> es un proyecto hecho por estudiantes, para estudiantes. Compartimos lo que
        nos habría gustado saber al empezar.
      </p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="footer-title">Secciones</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={navCta.href}>{navCta.label}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer-title">Comunidad no oficial</h2>
      <ul>
        {
          community.map((c) => (
            <li>
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener">
                  {c.name}
                </a>
              ) : (
                <span class="muted">{c.name} (próximamente)</span>
              )}
            </li>
          ))
        }
        <li class="footer-note">Grupos no oficiales, administrados por estudiantes.</li>
        <li><a href="/etiquetas">Todas las etiquetas</a></li>
        {site.repoUrl && <li><a href={site.repoUrl} target="_blank" rel="noopener">Código en GitHub</a></li>}
        {site.contact && <li><a href={site.contact}>Contacto</a></li>}
      </ul>
    </div>
  </div>

  <div class="container">
    <section class="official" aria-labelledby="footer-oficiales">
      <h2 id="footer-oficiales" class="official-title">Canales oficiales</h2>
      {
        officialChannels.map((group) => (
          <div class="official-row">
            <span class="official-group">
              {group.title} <span class="muted">· {group.kind}</span>
            </span>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener">
                    <Icon name={link.icon} size={16} />
                    {link.label === 'Web oficial' ? link.handle : link.label}
                    <span class="sr-only">de {group.title} (se abre en una pestaña nueva)</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>

  <div class="container bottom">
    <div class="brand-stripe" aria-hidden="true">
      <span style="background: var(--brand-green)"></span>
      <span style="background: var(--brand-yellow)"></span>
      <span style="background: var(--brand-purple)"></span>
      <span style="background: var(--brand-teal)"></span>
      <span style="background: var(--logo-ink)"></span>
      <span style="background: var(--brand-orange)"></span>
    </div>
    <p>
      © {year} {site.name}. Sitio estudiantil, no oficial. Contenido bajo{' '}
      <a href="https://creativecommons.org/licenses/by/4.0/deed.es" rel="license noopener" target="_blank">CC BY 4.0</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    padding-top: 56px;
    font-size: 0.95rem;
  }

  .grid-footer {
    display: grid;
    gap: 36px;
    grid-template-columns: 2fr 1fr 1fr;
  }

  .about p {
    color: var(--text-muted);
    max-width: 44ch;
  }

  .about :global(.footer-logo) {
    width: 72px;
    margin-bottom: 16px;
  }

  .footer-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--text);
    text-decoration: none;
  }

  .footer-note {
    margin-bottom: 6px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .official {
    display: grid;
    gap: 12px;
    margin-top: 36px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 2px solid var(--brand-yellow);
    background: color-mix(in srgb, var(--brand-yellow) 14%, var(--surface));
  }

  .official-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  .official-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .official-group {
    font-weight: 700;
    min-width: 260px;
  }

  .official-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .official-row a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 650;
    color: var(--link);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-block: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .bottom p {
    margin: 0;
  }

  .bottom .brand-stripe span {
    width: 14px;
    height: 14px;
    border-radius: 3px;
  }

  @media (max-width: 760px) {
    .grid-footer {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>

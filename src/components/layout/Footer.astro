---
import Logo from '../brand/Logo.astro';
import { community, nav, navCta, site } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid-footer">
    <div class="about">
      <Logo variant="full" class="footer-logo" />
      <p>
        <strong>{site.name}</strong> es un proyecto hecho por estudiantes, para estudiantes. Compartimos lo que
        nos habría gustado saber al empezar.
      </p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="footer-title">Secciones</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={navCta.href}>{navCta.label}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer-title">Comunidad</h2>
      <ul>
        {
          community.map((c) => (
            <li>
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener">
                  {c.name}
                </a>
              ) : (
                <span class="muted">{c.name} (próximamente)</span>
              )}
            </li>
          ))
        }
        <li class="footer-note">Grupos no oficiales, administrados por estudiantes.</li>
        <li><a href="/etiquetas">Todas las etiquetas</a></li>
        {site.repoUrl && <li><a href={site.repoUrl} target="_blank" rel="noopener">Código en GitHub</a></li>}
        {site.contact && <li><a href={site.contact}>Contacto</a></li>}
      </ul>
    </div>
  </div>

  {
    site.officialUrl && (
      <div class="container">
        <a class="official" href={site.officialUrl} target="_blank" rel="noopener">
          <span class="official-label">Web oficial de la UNETI</span>
          <span class="official-url">
            {site.officialLabel} <span aria-hidden="true">↗</span>
          </span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </div>
    )
  }

  <div class="container bottom">
    <div class="brand-stripe" aria-hidden="true">
      <span style="background: var(--brand-green)"></span>
      <span style="background: var(--brand-yellow)"></span>
      <span style="background: var(--brand-purple)"></span>
      <span style="background: var(--brand-teal)"></span>
      <span style="background: var(--logo-ink)"></span>
      <span style="background: var(--brand-orange)"></span>
    </div>
    <p>
      © {year} {site.name}. Sitio estudiantil, no oficial. Contenido bajo{' '}
      <a href="https://creativecommons.org/licenses/by/4.0/deed.es" rel="license noopener" target="_blank">CC BY 4.0</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    padding-top: 56px;
    font-size: 0.95rem;
  }

  .grid-footer {
    display: grid;
    gap: 36px;
    grid-template-columns: 2fr 1fr 1fr;
  }

  .about p {
    color: var(--text-muted);
    max-width: 44ch;
  }

  .about :global(.footer-logo) {
    width: 72px;
    margin-bottom: 16px;
  }

  .footer-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--text);
    text-decoration: none;
  }

  .footer-note {
    margin-bottom: 6px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .official {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
    margin-top: 36px;
    padding: 16px 20px;
    border-radius: var(--radius);
    border: 2px solid var(--brand-yellow);
    background: color-mix(in srgb, var(--brand-yellow) 14%, var(--surface));
    color: var(--text);
    text-decoration: none;
  }

  .official:hover {
    background: color-mix(in srgb, var(--brand-yellow) 26%, var(--surface));
  }

  .official-label {
    font-weight: 700;
  }

  .official-url {
    font-weight: 700;
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-block: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .bottom p {
    margin: 0;
  }

  .bottom .brand-stripe span {
    width: 14px;
    height: 14px;
    border-radius: 3px;
  }

  @media (max-width: 760px) {
    .grid-footer {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>

---
/**
 * Índice de un artículo con sus secciones principales (##).
 * - Al principio del texto: un recuadro desplegable.
 * - Al bajar: un botón "Índice" abre el mismo listado en un panel flotante,
 *   con la sección actual marcada. No ocupa espacio mientras se lee.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2);
---

<details class="toc" id="indice" open>
  <summary>En esta página</summary>
  <ol>
    {items.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
  </ol>
</details>

<div class="toc-float" hidden>
  <div class="toc-panel" id="toc-panel" role="dialog" aria-label="Índice" hidden>
    <p class="toc-panel-title">En esta página</p>
    <ol>
      {items.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
    </ol>
  </div>
  <button class="toc-button" type="button" aria-expanded="false" aria-controls="toc-panel">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      ></path></svg
    >
    Índice
  </button>
</div>

<script>
  const top = document.querySelector<HTMLDetailsElement>('.toc');
  const float = document.querySelector<HTMLElement>('.toc-float');
  const panel = document.querySelector<HTMLElement>('.toc-panel');
  const button = document.querySelector<HTMLButtonElement>('.toc-button');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = [...new Set(links.map((a) => a.dataset.tocLink!))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // En móvil el recuadro de arriba empieza cerrado
  if (top && matchMedia('(max-width: 759px)').matches) top.open = false;

  const setPanel = (open: boolean) => {
    if (!panel || !button) return;
    panel.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  };

  button?.addEventListener('click', () => setPanel(panel?.hidden ?? false));
  links.forEach((a) => a.addEventListener('click', () => setPanel(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setPanel(false));
  addEventListener('click', (e) => {
    if (float && !float.contains(e.target as Node)) setPanel(false);
  });

  // Marca la sección actual y muestra el botón cuando el índice de arriba ya no se ve
  let current = '';
  const update = () => {
    let active = '';
    for (const h of headings) {
      if (h.getBoundingClientRect().top - 140 <= 0) active = h.id;
      else break;
    }
    if (active !== current) {
      links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.tocLink === active));
      current = active;
    }
    if (float && top) {
      const visible = top.getBoundingClientRect().bottom > 0;
      float.hidden = visible;
      if (visible) setPanel(false);
    }
  };

  let ticking = false;
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true },
  );
  update();
</script>

<style>
  .toc {
    margin-bottom: 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 4px 18px;
  }

  summary {
    cursor: pointer;
    padding: 12px 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  ol {
    margin: 0;
    padding: 0 0 14px 1.4em;
    display: grid;
    gap: 4px;
  }

  .toc ol {
    columns: 2;
    column-gap: 32px;
    display: block;
  }

  .toc li {
    break-inside: avoid;
    padding: 2px 0;
  }

  li::marker {
    color: var(--text-muted);
    font-size: 0.85em;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  a[aria-current] {
    color: var(--accent);
    font-weight: 650;
  }

  .toc-float {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .toc-float[hidden],
  .toc-panel[hidden] {
    display: none;
  }

  .toc-panel {
    width: min(320px, calc(100vw - 32px));
    max-height: min(60vh, 480px);
    overflow-y: auto;
    padding: 14px 18px 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .toc-panel-title {
    margin: 0 0 8px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .toc-panel li {
    font-size: 0.95rem;
  }

  .toc-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border: 0;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font: inherit;
    font-weight: 650;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: var(--shadow);
  }

  @media (max-width: 759px) {
    .toc ol {
      columns: 1;
    }
  }
</style>
